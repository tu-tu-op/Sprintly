{
  "name": "sprintly",
  "displayName": "Sprintly",
  "description": "Strava for developers — track your coding sessions.",
  "version": "0.1.0",
  "engines": { "vscode": "^1.93.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "sprintly.startSession",    "title": "Sprintly: Start Session" },
      { "command": "sprintly.stopSession",     "title": "Sprintly: Stop Session" },
      { "command": "sprintly.pauseSession",    "title": "Sprintly: Pause Session" },
      { "command": "sprintly.resumeSession",   "title": "Sprintly: Resume Session" },
      { "command": "sprintly.resetSession",    "title": "Sprintly: Reset Session" },
      { "command": "sprintly.showStatusPanel", "title": "Open Quick Panel",       "category": "Sprintly" },
      { "command": "sprintly.openPanel",       "title": "Open Quick Panel",       "category": "Sprintly" },
      { "command": "sprintly.shareSession",    "title": "Share Session",          "category": "Sprintly" },
      { "command": "sprintly.saveSession",     "title": "Save Session",           "category": "Sprintly" },
      { "command": "sprintly.devOpenScreen",   "title": "Dev: Jump to Screen",    "category": "Sprintly" }
    ],
    "configuration": {
      "title": "Sprintly",
      "properties": {
        "sprintly.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable Sprintly."
        },
        "sprintly.autoPromptOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Ask whether to start a Sprintly session when VS Code opens."
        },
        "sprintly.pricing.claudeCode.input": {
          "type": "number",
          "minimum": 0,
          "default": 3.0,
          "description": "Estimated Claude Code input-token price in USD per million tokens."
        },
        "sprintly.pricing.claudeCode.output": {
          "type": "number",
          "minimum": 0,
          "default": 15.0,
          "description": "Estimated Claude Code output-token price in USD per million tokens."
        },
        "sprintly.pricing.claudeCode.cacheRead": {
          "type": "number",
          "minimum": 0,
          "default": 0.3,
          "description": "Estimated Claude Code cache-read token price in USD per million tokens."
        },
        "sprintly.pricing.claudeCode.cacheCreate": {
          "type": "number",
          "minimum": 0,
          "default": 3.75,
          "description": "Estimated Claude Code cache-creation token price in USD per million tokens."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test test/*.test.js",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.93.0",
    "typescript": "^5.x"
  }
}
